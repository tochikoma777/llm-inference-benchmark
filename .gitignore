# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.conda/

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Local configuration & secrets
# ---------------------------------------------------------------------------
.env
*.local.yaml
config/local.yaml

# ---------------------------------------------------------------------------
# Models (never commit weights)
# ---------------------------------------------------------------------------
models/
*.safetensors
*.bin
*.gguf

# ---------------------------------------------------------------------------
# Generated artifacts
#   Synthetic/CI results are ignored by default. If you publish a benchmark
#   run (like the reference results in reports/), copy the JSON into
#   `data/results/published/` and remove the ignore rule for that path.
# ---------------------------------------------------------------------------
data/results/*
!data/results/.gitkeep
!data/results/published/
logs/

# Generated figures/reports are reproducible artefacts:
#   make demo  →  reports/demo/
# Keep the demo's PNG + Markdown (small, useful in docs), ignore the
# multi-megabyte self-contained HTML and its sidecar JSON.
reports/figures/*
!reports/figures/.gitkeep
reports/generated/*
reports/demo/*.html
reports/demo/*.json
reports/ci/

# ---------------------------------------------------------------------------
# OS / IDE
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
